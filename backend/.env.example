# Backend Server Configuration
# Copy this file to .env and fill in your actual values
# .env is in .gitignore and will NOT be committed to git

# Server Port
PORT=3000

# Firebase Realtime Database URL
# Format: https://your-project-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase API Key (optional - for anonymous authentication)
# Get this from Firebase Console > Project Settings > General > Web API Key
FIREBASE_API_KEY=your-firebase-api-key-here

# Service account credentials (optional)
# Used only if you want Firebase Admin SDK to bypass RTDB rules.
# If you don't use service account, you can omit this and the proxy will rely on RTDB rules.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
